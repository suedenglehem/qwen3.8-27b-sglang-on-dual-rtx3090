+# Server-wide sampling defaults; consulted only where the client omitted a value.
+# Priority: client > SGLANG_DEFAULT_SAMPLING_PARAMS > model generation_config >
+# OpenAI defaults. Treat the returned dict as read-only (shared across requests).
+@lru_cache(maxsize=1)
+def _server_default_sampling_params() -> Dict[str, Any]:
+    raw = envs.SGLANG_DEFAULT_SAMPLING_PARAMS.get()
+    if not raw:
+        return {}
+    try:
+        parsed = json.loads(raw)
+    except json.JSONDecodeError:
+        logger.warning("Ignoring malformed SGLANG_DEFAULT_SAMPLING_PARAMS: %r", raw)
+        return {}
+    if not isinstance(parsed, dict):
+        logger.warning(
+            "SGLANG_DEFAULT_SAMPLING_PARAMS must be a JSON object, got %s; ignoring.",
+            type(parsed).__name__,
+        )
+        return {}
+    return parsed
+
